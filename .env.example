# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=postgresdb
DATABASE_URL=postgresql://user:password@localhost:5432/social_network?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/social_network?schema=public
DATABASE_POOL_LIMIT=20
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_QUERY_TIMEOUT_MS=10000

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_secure_password_here
REDIS_MAXMEMORY_POLICY=allkeys-lru

# JWT Secrets
JWT_ACCESS_SECRET=your_jwt_secret_here
JWT_ACCESS_TTL=date
JWT_REFRESH_SECRET=your_jwt_secret_here
JWT_REFRESH_TTL=date

# Media Storage Configuration
# STORAGE_DRIVER: 'local' (saves to ./uploads on computer) | 'minio' (or 's3' for local Docker MinIO) | 'r2' (Cloudflare R2) | 'auto' (default)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=uploads
LOCAL_STORAGE_PUBLIC_URL=http://localhost:3000

# Cloudflare R2 Object Storage (Production / Render)
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=social-network
R2_PUBLIC_URL=https://pub-<id>.r2.dev

# MinIO (Optional self-hosted S3 alternative for local dev if preferred)
MINIO_ROOT_USER=minio_user
MINIO_ROOT_PASSWORD=minio_password
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minio_user
MINIO_SECRET_KEY=minio_password
MINIO_BUCKET=social-network
MINIO_PUBLIC_URL=http://localhost:9000

# Docker
DOCKER_REGISTRY=your_docker

# Grafana
GF_SECURITY_ADMIN_USER=admin_name
GF_SECURITY_ADMIN_PASSWORD=grafana_admin_password
BACKUP_RETENTION_DAYS=7

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# WebRTC
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Calls
MAX_CALL_DURATION_MS=7200000
MAX_GROUP_CALL_PARTICIPANTS=32
CALL_RATE_LIMIT_PER_MINUTE=10
ENABLE_E2EE=true
SFU_ENABLED=false
MEDIASOUP_ANNOUNCED_IP=
