# Auto detect text files and normalize line endings to LF on checkout
* text=auto eol=lf

# Explicitly declare text files that should always be normalized
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.svg text eol=lf
*.sh text eol=lf
*.graphql text eol=lf
*.gql text eol=lf
*.prisma text eol=lf

# Docker & infrastructure
Dockerfile text
docker-compose*.yml text
*.conf text
nginx.conf text

# Config files
.editorconfig text
.gitattributes text
.gitignore text
.prettierrc.json text
.prettierignore text
.eslintignore text
.npmrc text
.nvmrc text
.env text
.env.example text
.env.* text

# Scripts
*.bash text eol=lf
*.zsh text eol=lf

# Declare binary files that should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.tiff binary
*.bmp binary

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Compiled / native
*.dylib.node binary
*.node binary
*.dll binary
*.so binary
*.dylib binary
*.exe binary
*.o binary
*.a binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.7z binary
*.rar binary
*.xz binary

# Database / binary data
*.sqlite binary
*.sqlite3 binary
*.db binary
*.bin binary
*.dat binary
*.wasm binary

# Documents
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary

# Media
*.mp3 binary
*.mp4 binary
*.wav binary
*.avi binary
*.mov binary
*.webm binary
*.flac binary

# Lock files (keep as-is)
package-lock.json binary
pnpm-lock.yaml binary
yarn.lock binary
bun.lockb binary
*.lock binary

# Terraform
*.tf text eol=lf
*.hcl text eol=lf
