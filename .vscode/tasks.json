{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Typecheck: All (Watch)",
      "dependsOn": [
        "Typecheck: Backend (Watch)",
        "Typecheck: Frontend (Watch)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Typecheck: Backend (Watch)",
      "type": "shell",
      "command": "pnpm",
      "args": ["exec", "tsc", "--noEmit", "--watch", "--preserveWatchOutput"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": "$tsc-watch",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Typecheck: Frontend (Watch)",
      "type": "shell",
      "command": "pnpm",
      "args": ["exec", "tsc", "--noEmit", "--watch", "--preserveWatchOutput"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": "$tsc-watch",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Lint: Check All",
      "type": "shell",
      "command": "pnpm",
      "args": ["lint"],
      "problemMatcher": "$eslint-compact",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
