{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "format": "prettier --write . --ignore-unknown --no-error-on-unmatched-pattern",
    "lint": "eslint . --ignore-pattern \"src/coverage\" --cache --cache-location .eslintcache",
    "lint:fix": "eslint . --ignore-pattern \"src/coverage\" --fix --cache --cache-location .eslintcache",
    "start": "node --max-old-space-size=2048 --expose-gc dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --max-old-space-size=2048 --expose-gc dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "test:mutation": "stryker run",
    "test:pact:verify": "tsx test/pact-verify.ts",
    "test:ci": "vitest run --reporter=github-actions --bail=1",
    "test:cov:ci": "vitest run --coverage --reporter=github-actions",
    "benchmark": "node ../scripts/bench/run-stress-tests.cjs",
    "benchmark:k6": "node ../scripts/bench/run-k6.cjs",
    "benchmark:autocannon": "node ../scripts/bench/run-autocannon.cjs",
    "benchmark:clinic": "node ../scripts/bench/run-clinic-profile.cjs",
    "benchmark:flame": "node ../scripts/bench/run-clinic-profile.cjs --flame",
    "benchmark:doctor": "node ../scripts/bench/run-clinic-profile.cjs --doctor"
  },
  "dependencies": {
