{
  "name": "backend",
  "sourceRoot": "apps/backend/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/apps/backend/dist"],
      "options": {
        "command": "pnpm build",
        "cwd": "apps/backend",
        "forwardAllArgs": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm lint",
        "cwd": "apps/backend",
        "forwardAllArgs": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm typecheck",
        "cwd": "apps/backend",
        "forwardAllArgs": false
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm start:dev",
        "cwd": "apps/backend",
        "forwardAllArgs": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm test:ci",
        "cwd": "apps/backend",
        "forwardAllArgs": false
      }
    }
  }
}
