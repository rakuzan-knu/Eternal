{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "exactOptionalPropertyTypes": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "jest", "node", "multer"],
    "paths": {
      "@backend/*": ["./src/*"],
      "@common/*": ["./src/common/*", "./src/common/*/index.ts"],
      "@common/prisma": ["./src/common/prisma/index.ts"],
      "@common/contracts": [
        "./src/common/contracts/index.ts",
        "../../packages/shared/contracts/src/index.ts"
      ],
      "@shared/*": ["../../packages/shared/*/src/index.ts"],
      "@shared/contracts": ["../../packages/shared/contracts/src/index.ts"],
      "@common/pagination": ["./src/common/pagination.ts"],
      "socket.io-client": ["./node_modules/socket.io-client/build/cjs/index.d.ts"]
    }
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "prisma.config.ts",
    "vitest.config.ts",
    "vitest.config.e2e.ts"
  ]
}
