{
  "name": "@eternal/desktop",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "generate:routes": "node scripts/generate-route-table.ts",
    "dev": "pnpm generate:routes && electron-vite dev --ignoreConfigWarning",
    "build": "pnpm generate:routes && pnpm typecheck && electron-vite build --ignoreConfigWarning",
    "preview": "electron-vite preview --ignoreConfigWarning",
    "package": "node scripts/package.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "e2e": "playwright test --config playwright.config.ts",
    "package:dir": "node scripts/package.ts --dir",
    "package:nsis": "node scripts/package.ts nsis",
    "package:msi": "node scripts/package.ts msi",
    "package:appx": "node scripts/package.ts appx",
    "package:dmg": "node scripts/package.ts dmg",
    "package:zip": "node scripts/package.ts zip",
    "package:appimage": "node scripts/package.ts AppImage",
    "package:deb": "node scripts/package.ts deb",
    "package:rpm": "node scripts/package.ts rpm",
    "package:flatpak": "node scripts/package.ts flatpak",
    "package:snap": "node scripts/package.ts snap",
    "generate:icons": "node scripts/generate-icons.ts",
    "package:msix": "node scripts/package.ts msix"
  },
  "dependencies": {
    "@sentry/electron": "8.3.0",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.12",
    "uiohook-napi": "1.5.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "9.39.5",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  }
}
