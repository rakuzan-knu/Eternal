{
  "expo": {
    "name": "Eternal Social",
    "slug": "eternal-social",
    "version": "1.0.0",
    "description": "Next-generation social network connecting people who matter.",
    "scheme": "eternal",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Eternal to attach photos and videos to your posts and stories.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#050505"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eternalsocial.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to securely log in to your Eternal account."
      }
    },
    "android": {
      "package": "com.eternalsocial.app",
      "adaptiveIcon": {
        "backgroundColor": "#050505"
      },
      "permissions": ["USE_BIOMETRIC", "USE_FINGERPRINT"]
    },
    "web": {
      "bundler": "metro",
      "shortName": "Eternal",
      "backgroundColor": "#050505",
      "themeColor": "#050505",
      "lang": "en"
    },
    "platforms": ["ios", "android", "web"]
  }
}
