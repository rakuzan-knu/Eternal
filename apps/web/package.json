{
  "name": "frontend",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.0.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node ./scripts/prerender-static-seo.js",
    "preview": "vite preview",
    "lint": "eslint . --ignore-pattern \"storybook-static\" --ignore-pattern \"coverage\" --cache --cache-location .eslintcache",
    "lint:fix": "eslint . --ignore-pattern \"storybook-static\" --ignore-pattern \"coverage\" --fix",
    "format": "prettier --write . --ignore-unknown --no-error-on-unmatched-pattern",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:cov": "vitest run --config vitest.config.ts --coverage",
    "test:ui": "vitest --config vitest.config.ts --ui",
    "test:e2e": "playwright test",
    "test:performance": "playwright test --config playwright.performance.config.ts",
    "test:memory": "playwright test --config playwright.memory.config.ts",
    "test:media-performance": "playwright test --config playwright.media-performance.config.ts",
    "test:data-window": "playwright test --config playwright.data-window.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:design": "playwright test --config playwright.design.config.ts",
    "test:design:platforms": "playwright test --config playwright.platforms.config.ts",
    "typecheck": "tsc --noEmit",
    "check:bundle": "node ../../scripts/ci/check-bundle-size.js",
    "check:startup": "node scripts/check-startup-chunks.mjs",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test:mutation": "stryker run",
    "knip": "knip",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:ci": "vitest run --config vitest.config.ts --reporter=github-actions",
    "test:cov:ci": "vitest run --config vitest.config.ts --coverage --reporter=github-actions",
    "test:visual": "chromatic --storybook-build-dir=storybook-static"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@mediapipe/selfie_segmentation": "^0.1.1675465747",
    "@sentry/react": "10.75.3",
    "@simplewebauthn/browser": "^14.0.0",
    "@social-network/shared-api-client": "workspace:*",
    "@social-network/shared-contracts": "workspace:*",
    "@social-network/shared-crypto": "workspace:*",
    "@social-network/shared-socket": "workspace:*",
    "@social-network/shared-stores": "workspace:*",
    "@social-network/shared-ui-primitives": "workspace:*",
    "@social-network/shared-utils": "workspace:*",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-persist-client": "^5.104.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/jszip": "^3.4.1",
    "axios": "^1.20.0",
    "blurhash": "^2.0.5",
    "dompurify": "^3.4.16",
    "emoji-picker-react": "^4.22.3",
    "framer-motion": "^13.5.0",
    "hls.js": "^1.7.2",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.2",
    "katex": "^0.19.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.49.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "socket.io-client": "^4.8.4",
    "socket.io-msgpack-parser": "^3.0.2",
    "tailwindcss": "^4.3.1",
    "uid": "^2.0.2",
    "yjs": "^13.6.33",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@pact-foundation/pact": "^17.1.4",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^8.6.19",
    "@storybook/addon-essentials": "^8.6.19",
    "@storybook/addon-interactions": "^8.6.19",
    "@storybook/react": "^8.6.19",
    "@storybook/react-vite": "^8.6.19",
    "@storybook/test": "^8.6.19",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "4.3.3",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "chromatic": "^18.12.2",
    "eslint": "^9.39.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.6",
    "jsdom": "^26.1.0",
    "msw": "^2.14.6",
    "prettier": "^3.9.10",
    "socket.io": "^4.8.4",
    "storybook": "^8.6.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  }
}
