# Database
DATABASE_URL=postgresql://user:password@localhost:5432/social?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT — access and refresh must use DIFFERENT secrets, min 32 chars each
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=7d

# App
PORT=3000
CORS_ORIGIN=http://localhost:5173

# AWS (optional for local dev)
AWS_BUCKET_NAME=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=
