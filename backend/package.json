{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint . --ignore-pattern \"src/coverage\" --cache --cache-location .eslintcache",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --ignore-pattern \"src/coverage\" --fix",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand --forceExit --detectOpenHandles --testTimeout=10000",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.29",
    "@prisma/client": "^5.22.0",
    "@sentry/nestjs": "10.70.0",
    "@types/geoip-lite": "1.4.4",
    "@types/ua-parser-js": "0.7.39",
    "argon2": "^0.45.1",
    "bullmq": "^5.81.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "geoip-lite": "2.0.3",
    "import-in-the-middle": "^1.14.1",
    "ioredis": "^5.11.1",
    "iterare": "^1.2.1",
    "libphonenumber-js": "^1.11.19",
    "load-esm": "^1.0.0",
    "luxon": "^3.5.0",
    "multer": "^2.2.0",
    "nestjs-pino": "^4.6.1",
    "node-gyp-build": "^4.8.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino-http": "^11.0.0",
    "prisma": "^5.22.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "require-in-the-middle": "^7.5.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.14.0",
    "sharp": "^0.35.2",
    "socket.io": "^4.8.3",
    "streamsearch": "^1.1.0",
    "ua-parser-js": "2.0.10",
    "uid": "^2.0.2",
    "validator": "^13.12.0"
  },
  "overrides": {
    "multer": "^2.2.0",
    "uuid": "^11.1.1",
    "js-yaml": "^5.2.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@jest/core": "^30.0.0",
    "@jest/reporters": "^30.0.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "1.4.13",
    "@types/node": "^24.13.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/sanitize-html": "^2.14.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "find-up": "^4.1.0",
    "globals": "^17.0.0",
    "import-local": "^3.0.2",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-lib-source-maps": "^4.0.1",
    "istanbul-reports": "^3.1.7",
    "jest": "^30.0.0",
    "levn": "0.4.1",
    "optionator": "0.9.4",
    "pirates": "4.0.7",
    "pkg-dir": "^4.2.0",
    "prettier": "^3.4.2",
    "resolve-cwd": "^3.0.0",
    "resolve-from": "^5.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.module.ts",
      "!**/main.ts",
      "!**/*.dto.ts",
      "!**/*.interface.ts",
      "!**/*.decorator.ts",
      "!**/*.guard.ts",
      "!**/*.strategy.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test-setup.ts"
    ],
    "testEnvironment": "node"
  }
}
