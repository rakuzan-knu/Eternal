generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  username         String           @unique
  displayName      String?
  passwordHash     String
  avatar           String?
  bio              String?
  banner           String?
  bannerPosition   Int              @default(50)
  isPrivate        Boolean          @default(false)
  birthDate        DateTime?
  lastSeenAt       DateTime?
  autoDeletePeriod AutoDeletePeriod @default(OFF)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  posts     Post[]
  followers Follow[]  @relation("following")
  following Follow[]  @relation("follower")
  comments  Comment[]

  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]                 @relation("SentMessages")
  messageReactions         MessageReaction[]
  blockedUsers             UserBlock[]               @relation("Blocker")
  blockedByUsers           UserBlock[]               @relation("Blocked")
  reportsFiled             Report[]                  @relation("Reporter")
  reportsReceived          Report[]                  @relation("Reported")
  deletedMessages          MessageDeletion[]
  privacy                  UserPrivacy?
  privacyExceptions        PrivacyException[]        @relation("PrivacyOwner")
  privacyTargetedBy        PrivacyException[]        @relation("PrivacyTarget")
  sessions                 Session[]
  polls Poll[] @relation("CreatedPolls")
  votes Vote[]
}

model Post {
  id        String   @id @default(uuid())
  content   String
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User      @relation(fields: [authorId], references: [id])
  authorId String
  likes    Like[]
  comments Comment[]
  poll     Poll?
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Follow {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now())
  status      FollowStatus @default(ACCEPTED)
  follower    User         @relation("follower", fields: [followerId], references: [id])
  followerId  String
  following   User         @relation("following", fields: [followingId], references: [id])
  followingId String

  @@unique([followerId, followingId])
  @@index([followingId, status])
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id          String           @id @default(uuid())
  type        ConversationType @default(DIRECT)
  /// Group-only fields
  name        String? // group display name
  avatar      String? // group avatar URL
  description String?
  /// Who created this conversation (group admin baseline)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  participants   ConversationParticipant[]
  messages       Message[]
  pinnedMessages PinnedMessage[]

  @@index([createdAt])
}

enum ConversationType {
  DIRECT
  GROUP
}

model ConversationParticipant {
  id             String          @id @default(uuid())
  conversationId String
  userId         String
  nickname       String?
  role           ParticipantRole @default(MEMBER)
  theme          String?         @default("default")
  muteLevel      MuteLevel       @default(NONE)
  mutedUntil     DateTime?
  leftAt         DateTime?
  archivedAt     DateTime?
  lastReadAt     DateTime        @default(now())
  joinedAt       DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

enum ParticipantRole {
  MEMBER
  ADMIN
  OWNER
}

enum MuteLevel {
  NONE
  MESSAGES
  CALLS
  MESSAGES_AND_CALLS
}

model Message {
  id              String      @id @default(uuid())
  conversationId  String
  senderId        String
  body            String?
  messageType     MessageType @default(TEXT)
  replyToId       String?
  forwardedFromId String?
  deletedAt       DateTime?
  deletedForAll   Boolean     @default(false)
  editedAt        DateTime?
  createdAt       DateTime    @default(now())

  conversation  Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender        User                @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo       Message?            @relation("Replies", fields: [replyToId], references: [id])
  replies       Message[]           @relation("Replies")
  forwardedFrom Message?            @relation("Forwards", fields: [forwardedFromId], references: [id])
  forwards      Message[]           @relation("Forwards")
  attachments   MessageAttachment[]
  reactions     MessageReaction[]
  deletedFor    MessageDeletion[]
  pinnedIn      PinnedMessage[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([createdAt])
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  GIF
  STICKER
  LOCATION
  CALL_LOG // missed / answered call record
  SYSTEM // "X joined", "theme changed", etc.
  DELETED // tombstone after hard-delete for all
}

model MessageAttachment {
  id           String         @id @default(uuid())
  messageId    String
  type         AttachmentType
  url          String // S3 / CDN URL
  fileName     String? // original file name
  mimeType     String?
  size         Int? // bytes
  width        Int? // images / videos
  height       Int?
  duration     Int? // audio / video seconds
  thumbnailUrl String?
  createdAt    DateTime       @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

enum AttachmentType {
  IMAGE
  VIDEO
  AUDIO
  FILE
  LINK // open-graph link preview
  GIF
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String // unicode emoji
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One reaction type per user per message
  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model PinnedMessage {
  id             String   @id @default(uuid())
  conversationId String
  messageId      String
  pinnedByUserId String
  pinnedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([conversationId, messageId])
  @@index([conversationId])
}

model MessageDeletion {
  messageId String
  userId    String
  deletedAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
}

model Report {
  id         String         @id @default(uuid())
  reporterId String
  reportedId String
  /// Conversation or message context (optional)
  messageId  String?
  category   ReportCategory
  details    String?
  status     ReportStatus   @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reportedId])
  @@index([status])
}

enum ReportCategory {
  SPAM
  SUICIDE_SELF_HARM
  IMPERSONATION
  VIOLENCE_DANGEROUS_ORGS
  NUDITY_SEXUAL
  RESTRICTED_GOODS
  FRAUD
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

enum Visibility {
  EVERYBODY // anyone
  CONTACTS // followers (ACCEPTED)
  NOBODY
}

enum PrivacyDimension {
  LAST_SEEN
  AVATAR
  BANNER
  FORWARD_LINK
  CALLS
  VOICE_MESSAGES
  MESSAGES
  BIRTHDAY
  BIO
  GROUP_INVITES
}

enum ExceptionMode {
  ALLOW
  DENY
}

enum AutoDeletePeriod {
  OFF
  DAY
  WEEK
  MONTH
  QUARTER
}

model UserPrivacy {
  userId        String     @id
  lastSeen      Visibility @default(EVERYBODY)
  avatar        Visibility @default(EVERYBODY)
  banner        Visibility @default(EVERYBODY)
  forwardLink   Visibility @default(EVERYBODY)
  calls         Visibility @default(EVERYBODY)
  voiceMessages Visibility @default(EVERYBODY)
  messages      Visibility @default(EVERYBODY)
  birthday      Visibility @default(NOBODY)
  bio           Visibility @default(EVERYBODY)
  groupInvites  Visibility @default(EVERYBODY)
  updatedAt     DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PrivacyException {
  ownerId   String
  targetId  String
  dimension PrivacyDimension
  mode      ExceptionMode
  createdAt DateTime         @default(now())

  owner  User @relation("PrivacyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  target User @relation("PrivacyTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([ownerId, dimension, targetId])
  @@index([ownerId, dimension])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  jti          String   @unique
  deviceName   String?
  userAgent    String?
  ip           String?
  city         String?
  country      String?
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
model Poll {
  id          String    @id @default(uuid())
  title       String    @db.VarChar(255)
  description String?   @db.Text
  isMultiple  Boolean   @default(false) @map("is_multiple")
  isActive    Boolean   @default(true) @map("is_active")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  options PollOption[]
  votes   Vote[]

  authorId String @map("author_id")
  author   User   @relation("CreatedPolls", fields: [authorId], references: [id], onDelete: Cascade)

  postId String @unique @map("post_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@map("polls")
}

model PollOption {
  id         String @id @default(uuid())
  pollId     String @map("poll_id")
  optionText String @map("option_text") @db.VarChar(255)
  votesCount Int    @default(0) @map("votes_count")
  sortOrder  Int    @default(0) @map("sort_order")

  poll  Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes Vote[]

  @@index([pollId])
  @@map("poll_options")
}

model Vote {
  id        String   @id @default(uuid())
  pollId    String   @map("poll_id")
  optionId  String   @map("option_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId], name: "unique_user_vote_per_poll")
  @@index([pollId, userId])
  @@map("votes")
}
