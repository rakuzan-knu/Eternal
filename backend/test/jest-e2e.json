{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transformIgnorePatterns": [
    "node_modules/(?!sanitize-html|htmlparser2|domutils|domhandler|dom-serializer|entities|domelementtype)"
  ],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
