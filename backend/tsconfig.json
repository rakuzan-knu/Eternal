{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2022",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "strict": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["jest", "node", "multer"],
    "baseUrl": ".",
    "paths": {
      "@backend/*": ["./src/*"],
      "@common/*": ["./src/common/*", "./src/common/*/index.ts"],
      "@common/prisma": ["./src/common/prisma/index.ts"],
      "@common/contracts": ["./src/common/contracts/index.ts"],
      "@common/pagination": ["./src/common/pagination/index.ts"]
    }
  },
  "include": ["src/**/*", "test/**/*"]
}
