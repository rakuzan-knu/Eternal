{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --force",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ignore-pattern \"storybook-static\" --ignore-pattern \"coverage\" --cache --cache-location .eslintcache",
    "lint:fix": "eslint . --ignore-pattern \"storybook-static\" --ignore-pattern \"coverage\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:cov": "vitest run --config vitest.config.ts --coverage",
    "test:ui": "vitest --config vitest.config.ts --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "check:bundle": "node ../scripts/check-bundle-size.js",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test:mutation": "stryker run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:ci": "vitest run --config vitest.config.ts --reporter=github-actions",
    "test:cov:ci": "vitest run --config vitest.config.ts --coverage --reporter=github-actions",
    "test:visual": "chromatic --storybook-build-dir=storybook-static"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@sentry/react": "10.70.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "emoji-picker-react": "^4.19.1",
    "framer-motion": "^13.1.1",
    "html-to-image": "^1.11.13",
    "katex": "^0.18.4",
    "lucide-react": "^1.33.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.2",
    "react-router-dom": "^7.18.2",
    "react-virtuoso": "^4.18.12",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.1",
    "uid": "^2.0.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@pact-foundation/pact": "^17.1.2",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "4.3.3",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "chromatic": "^18.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "jsdom": "^26.1.0",
    "msw": "^2.14.6",
    "prettier": "^3.5.3",
    "storybook": "^8.6.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
