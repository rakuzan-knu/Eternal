{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --force",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ignore-pattern \"storybook-static\" --ignore-pattern \"coverage\" --cache --cache-location .eslintcache",
    "lint:fix": "eslint . --ignore-pattern \"storybook-static\" --ignore-pattern \"coverage\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:cov": "vitest run --config vitest.config.ts --coverage",
    "test:ui": "vitest --config vitest.config.ts --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "check:bundle": "node ../scripts/check-bundle-size.js",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test:mutation": "stryker run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:ci": "vitest run --config vitest.config.ts --reporter=default --reporter=github-actions",
    "test:cov:ci": "vitest run --config vitest.config.ts --coverage --reporter=default --reporter=github-actions",
    "test:visual": "chromatic --storybook-build-dir=storybook-static"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@sentry/react": "10.70.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "emoji-picker-react": "^4.19.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-router": "^7.18.0",
    "react-router-dom": "^7.18.1",
    "react-virtuoso": "4.18.11",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@pact-foundation/pact": "^17.1.2",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^8.6.0",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/addon-interactions": "^8.6.0",
    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@storybook/test": "^8.6.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "4.3.3",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "browser-assert": "^1.2.1",
    "chromatic": "^18.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "glob": "^10.4.5",
    "globals": "^17.6.0",
    "happy-dom": "^20.11.2",
    "jsdoc-type-pratt-parser": "^4.1.0",
    "jsdom": "^26.1.0",
    "lru-cache": "^10.4.3",
    "memoizerific": "^1.11.3",
    "minipass": "^7.1.2",
    "msw": "^2.14.6",
    "path-scurry": "^1.11.1",
    "prettier": "^3.5.3",
    "process": "^0.11.10",
    "recast": "^0.24.0",
    "storybook": "^8.6.0",
    "strip-literal": "4.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.61.0",
    "unplugin": "^2.2.0",
    "util": "^0.12.5",
    "vite": "^6.0.0",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "vite": "$vite",
    "uuid": "^11.1.1",
    "js-yaml": ">=5.2.2"
  }
}
