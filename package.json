{
  "name": "social-network",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "postinstall": "node scripts/utils/postinstall.js && node scripts/utils/ensure-native.js",
    "dev:backend": "pnpm --filter backend start:dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:mobile": "pnpm --filter @social-network/mobile start",
    "dev": "concurrently -n backend,frontend -c blue,green \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "build": "pnpm -r build",
    "build:native": "pnpm build:codec && pnpm build:text && pnpm build:blind && pnpm build:feed && pnpm --filter @social-network/native build",
    "build:codec": "pnpm --filter @social-network/msg-codec build",
    "build:text": "pnpm --filter @social-network/text-pipeline build",
    "build:blind": "pnpm --filter @social-network/blinded-crypto build",
    "build:feed": "pnpm --filter @social-network/feed-score build",
    "test:native": "pnpm --filter @social-network/native test",
    "test:codec": "pnpm --filter @social-network/msg-codec test",
    "test:text": "pnpm --filter @social-network/text-pipeline test",
    "test:blind": "pnpm --filter @social-network/blinded-crypto test",
    "test:feed": "pnpm --filter @social-network/feed-score test",
    "bench:msg-codec": "pnpm --filter @social-network/native bench",
    "bench:text": "pnpm --filter @social-network/text-pipeline bench",
    "bench:blind": "pnpm --filter @social-network/blinded-crypto bench",
    "bench:feed": "pnpm --filter @social-network/feed-score bench",
    "lint": "pnpm -r --parallel lint",
    "lint:fix": "pnpm -r --parallel lint:fix",
    "test": "vitest run",
    "test:backend": "vitest run --project=backend",
    "test:frontend": "vitest run --project=frontend",
    "test:cov": "vitest run --coverage",
    "test:e2e": "pnpm --filter backend test:e2e",
    "format": "prettier --write . --ignore-unknown --no-error-on-unmatched-pattern",
    "typecheck": "pnpm -r --parallel typecheck",
    "prepare": "node -e \"process.env.CI || require('child_process').execSync('husky', { stdio: 'inherit' })\"",
    "docker:dev": "docker compose -f docker-compose.dev.yml",
    "docker:dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:dev:build": "docker compose -f docker-compose.dev.yml build",
    "docker:prod": "docker compose -f docker-compose.prod.yml",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d",
    "docker:prod:monitoring": "docker compose --profile monitoring -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml build",
    "docker:clean": "docker compose -f docker-compose.dev.yml down -v --remove-orphans && docker compose -f docker-compose.prod.yml down -v --remove-orphans",
    "docker:prune": "docker system prune -f && docker volume prune -f",
    "lhci": "lhci autorun",
    "check:bundle": "node scripts/ci/check-bundle-size.cjs",
    "check:portable": "node scripts/ci/check-portable.cjs",
    "perf:gates": "node scripts/ci/check-perf-budget.cjs",
    "validate:eol": "node scripts/ci/validate-eol.js",
    "fix:eol": "node scripts/ci/validate-eol.js --fix",
    "validate:env": "node scripts/utils/check-env.js",
    "validate:actions": "node scripts/ci/verify-actions-pinned.cjs",
    "clean": "node scripts/utils/clean.js",
    "clean:prune": "node scripts/utils/clean.js --prune",
    "format:check": "prettier --check . --ignore-unknown --no-error-on-unmatched-pattern",
    "knip": "knip",
    "knip:production": "knip --production",
    "test:mutation": "pnpm --filter backend test:mutation && pnpm --filter frontend test:mutation",
    "benchmark": "node scripts/bench/run-stress-tests.cjs",
    "benchmark:k6": "node scripts/bench/run-k6.cjs",
    "benchmark:autocannon": "node scripts/bench/run-autocannon.cjs",
    "benchmark:clinic": "node scripts/bench/run-clinic-profile.cjs",
    "benchmark:flame": "node scripts/bench/run-clinic-profile.cjs --flame",
    "benchmark:doctor": "node scripts/bench/run-clinic-profile.cjs --doctor",
    "benchmark:pre-release": "node scripts/bench/run-stress-tests.cjs --strict",
    "benchmark:socket-storm": "k6 run benchmarks/k6/socket-reconnect-storm.js",
    "benchmark:socket-signaling": "node benchmarks/socketio-signaling-bench.cjs",
    "perf:verify": "node scripts/ci/verify-performance-benchmarks.cjs",
    "validate": "pnpm validate:eol && pnpm validate:env && pnpm validate:actions && pnpm typecheck && pnpm lint && pnpm knip"
  },
  "devDependencies": {
    "0x": "^6.0.0",
    "@clinic/doctor": "^11.0.0",
    "@clinic/flame": "^13.0.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@lhci/cli": "^0.15.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/autocannon": "^7.12.7",
    "autocannon": "^8.0.0",
    "clinic": "^13.0.0",
    "concurrently": "^10.0.5",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "9.39.5",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.0",
    "knip": "^6.34.0",
    "lint-staged": "^17.3.0",
    "nx": "^23.1.1",
    "prettier": "^3.5.3",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild": true,
    "prisma": true,
    "@prisma/client": true,
    "argon2": true,
    "node-gyp-build": true,
    "cross-env": true,
    "msw": true,
    "msgpackr-extract": true,
    "unrs-resolver": true,
    "@swc/core": true,
    "nx": true,
    "@scarf/scarf": false
  },
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=10.0.0"
  },
  "msw": {
    "workerDirectory": [
      "apps/web/public"
    ]
  }
}
