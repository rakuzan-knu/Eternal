{
  "name": "social-network",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "dev:backend": "npm run start:dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "lint": "npm run lint -w backend && npm run lint -w frontend",
    "lint:fix": "npm run lint:fix -w backend && npm run lint:fix -w frontend",
    "test": "npm run test -w backend && npm run test -w frontend",
    "test:cov": "npm run test:cov -w backend && npm run test:cov -w frontend",
    "test:e2e": "npm run test:e2e -w backend",
    "format": "npm run format -w backend && npm run format -w frontend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "prepare": "node -e \"process.env.CI || require('child_process').execSync('husky', { stdio: 'inherit' })\""
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "semantic-release": "^24.2.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "conventional-changelog-conventionalcommits": "^8.0.0"
  },
  "overrides": {
    "vite": "^8.1.3",
    "multer": "^2.2.0",
    "uuid": "^11.1.1",
    "js-yaml": "^4.2.0",
    "@storybook/react-vite": {
      "vite": "^8.1.3"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "prisma": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "argon2": true,
    "msw": true,
    "msgpackr-extract": true,
    "unrs-resolver": true,
    "@scarf/scarf": false
  },
  "lint-staged": {
    "backend/src/**/*.ts": [
      "npm exec -w backend -- eslint --fix",
      "npm exec -w backend -- prettier --write"
    ],
    "frontend/src/**/*.{ts,tsx}": [
      "npm exec -w frontend -- eslint --fix",
      "npm exec -w frontend -- prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  }
}