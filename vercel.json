{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter frontend build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "pnpm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://social-network-backend-4h47.onrender.com/v1/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://social-network-backend-4h47.onrender.com/v1/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "https://social-network-backend-4h47.onrender.com/v1/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://social-network-backend-4h47.onrender.com/v1/auth/:path*"
    },
    {
      "source": "/integrations/:path*",
      "destination": "https://social-network-backend-4h47.onrender.com/v1/integrations/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://social-network-backend-4h47.onrender.com/uploads/:path*"
    },
    {
      "source": "/health",
      "destination": "https://social-network-backend-4h47.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-XSS-Protection",
          "value": "0"
        }
      ]
    }
  ]
}
